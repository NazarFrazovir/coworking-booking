APP_NAME=CoWork Booking API
ENVIRONMENT=development

# postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/coworking_booking

# --- Auth (lab #2) ---
# Згенеруйте свій: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# true за HTTPS, щоб cookie з токеном не передавався по http
COOKIE_SECURE=false
