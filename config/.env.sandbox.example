# ============================================================
#  SANDBOX (тестове середовище)
#  Скопіюйте:  cp config/.env.sandbox.example .env.sandbox
#  Файл .env.sandbox НЕ комітиться (див. .gitignore).
# ============================================================
APP_ENV=sandbox

# Відладка: детальні трейсбеки у браузері, докладні логи
DEBUG=true
LOG_LEVEL=DEBUG
DOCS_ENABLED=true
SQL_ECHO=false

# --- Окрема БД sandbox (docker compose -p cowork-sandbox) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=coworking_sandbox
POSTGRES_USER=cowork_sandbox
POSTGRES_PASSWORD=change-me-sandbox-password

# --- Auth ---
# Згенеруйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-sandbox-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
