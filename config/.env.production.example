# ============================================================
#  PRODUCTION (робоче середовище)
#  Скопіюйте:  cp config/.env.production.example .env.production
#  і ОБОВ'ЯЗКОВО замініть усі значення change-me на справжні.
#  Застосунок не стартує з DEBUG=true або слабким JWT_SECRET_KEY.
# ============================================================
APP_ENV=production

# Відладку вимкнено: користувач ніколи не бачить стектрейсів
DEBUG=false
LOG_LEVEL=INFO
DOCS_ENABLED=false
SQL_ECHO=false

# --- Окрема БД production (docker compose -p cowork-production) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_DB=coworking_production
POSTGRES_USER=cowork_production
POSTGRES_PASSWORD=change-me-strong-production-password

# Хмарний хостинг зазвичай дає один рядок — тоді замість POSTGRES_*:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Мінімум 32 випадкові символи:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# true, коли сайт працює через HTTPS
COOKIE_SECURE=false
