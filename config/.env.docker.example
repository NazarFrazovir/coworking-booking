# ============================================================
#  Docker Compose (lab #5)
#  cp config/.env.docker.example .env
#  docker compose up --build
#  Файл .env НЕ комітиться (див. .gitignore).
# ============================================================
APP_ENV=sandbox
DEBUG=false
LOG_LEVEL=INFO
DOCS_ENABLED=true
# Демо-простори й користувачі при першому запуску (лише sandbox)
SEED_DEMO=true

# Порт застосунку на вашому комп'ютері: http://localhost:8000
APP_PORT=8000

# --- PostgreSQL у контейнері (хост "db" усередині мережі compose) ---
POSTGRES_DB=coworking_sandbox
POSTGRES_USER=cowork_sandbox
POSTGRES_PASSWORD=change-me-sandbox-password
# Порт БД на localhost — лише в режимі розробки (docker-compose.dev.yml)
POSTGRES_PORT=5435

# --- Auth ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-sandbox-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
